# /etc/k-on-office.env  (chmod 640, owner root:kon)
DOE_ENV=production
DOE_DATA_DIR=/var/lib/k-on-office
DOE_DATABASE_URL=sqlite:////var/lib/k-on-office/k-on.sqlite3
DOE_TIMEZONE=Asia/Shanghai
# Real punches only: custom punch times are limited to attendance managers.
DOE_SIMULATION_MODE=0
DOE_ALLOW_REGISTRATION=1
DOE_REGISTER_LIMIT_PER_HOUR=5
